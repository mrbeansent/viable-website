# Copy to Vercel > Project > Settings > Environment Variables. At least one lead channel must be set,
# or forms show an error instead of a fake success.

# Lead channel 1: Gmail SMTP (team alert to info@ + audit confirmation to the lead)
SMTP_USER=info@viable-works.com
SMTP_PASS=            # Google app password (16 chars, needs 2-Step Verification on that account)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# LEAD_ALERT_TO=info@viable-works.com
# SMTP_FROM="Viable Works <info@viable-works.com>"   # audit confirmation uses its own From in lib/emails/auditReceived.ts

# Lead channel 2: webhook (n8n once it is public). GHL_WEBHOOK_URL is still read as a fallback.
# LEAD_WEBHOOK_URL=https://n8n.example.com/webhook/viable-lead
# LEAD_WEBHOOK_SECRET=  # sent as X-Viable-Secret; check it in the n8n Webhook node

# Booking (/book). Cal.com event link; name/email are prefilled from the audit thank-you page.
NEXT_PUBLIC_CALENDAR_URL=https://cal.com/YOUR-USERNAME/15min

# Optional: Search Console HTML-tag verification (skip if you verify the Domain property by DNS TXT)
# NEXT_PUBLIC_GSC_VERIFICATION=
